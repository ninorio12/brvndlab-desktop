{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brvndlab",
  "version": "0.1.2",
  "identifier": "com.brvndlab.desktop",
  "build": {
    "frontendDist": "https://app.brvndlab.com",
    "devUrl": "https://app.brvndlab.com"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Brvndlab",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Brvndlab",
    "category": "Productivity",
    "shortDescription": "L'OS de ta marque personnelle",
    "longDescription": "Brvndlab, l'OS de ta marque personnelle.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Brvndlab",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
